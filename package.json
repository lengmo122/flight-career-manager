{
  "name": "flight-career-manager",
  "version": "1.0.139",
  "main": "electron-main.mjs",
  "description": "微软模拟飞行职业生涯与任务管理器",
  "author": "模飞生涯",
  "private": true,
  "type": "module",
  "scripts": {
    "precheck": "node tests/simulator-auto-connect.test.mjs && node tests/glassout-integration.test.mjs && node tests/panel-cancellation.test.mjs",
    "start": "node server.mjs",
    "desktop": "electron electron-main.mjs",
    "dist:win": "node tools/package-fast.mjs",
    "dist:win:portable": "electron-builder --win portable",
    "test:auto-connect": "node tests/simulator-auto-connect.test.mjs",
    "test:panels": "node tests/glassout-integration.test.mjs",
    "test:panels:native": "node tests/panel-native.test.mjs && node tests/panel-native.test.mjs --enhanced && node tests/panel-native.test.mjs --untracked && node tests/panel-native-lan.test.mjs",
    "check": "node tools/check-syntax.mjs && node tools/run-tests.mjs && dotnet run --project tools/msfs-telemetry-source-tests/SkylineVA.Msfs2024Telemetry.Tests.csproj -c Release",
    "test:js": "node tools/run-tests.mjs",
    "release:win": "electron-builder --win nsis --publish always"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "electron": "^37.2.6",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.flightcareer.manager",
    "productName": "模飞生涯",
    "icon": "assets/app-icon.ico",
    "files": [
      "index.html",
      "styles.css",
      "src/**/*",
      "terrain.js",
      "server.mjs",
      "panel-agent.mjs",
      "panel-discovery.mjs",
      "panel-native.mjs",
      "panel-service.mjs",
      "electron-main.mjs",
      "preload.cjs",
      "package.json",
      "assets/**/*"
    ],
    "extraResources": [
      {
        "from": "tools/panel-capture",
        "to": "panel-capture",
        "filter": [
          "MofeiCapture.dll",
          "MofeiCaptureHost.exe",
          "MinHook-LICENSE.txt"
        ]
      },
      {
        "from": "tools/msfs-telemetry",
        "to": "telemetry"
      },
      {
        "from": "tools/msfs-scene-bridge",
        "to": "scene-bridge",
        "filter": [
          "SkylineVA.MsfsSceneBridge.exe",
          "SimConnect.dll"
        ]
      }
    ],
    "win": {
      "target": "nsis",
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "lengmo122",
        "repo": "flight-career-manager"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "node-edge-tts": "^1.2.10",
    "ws": "8.18.3"
  }
}

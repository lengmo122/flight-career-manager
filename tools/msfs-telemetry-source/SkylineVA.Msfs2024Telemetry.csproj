<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>SkylineVA.Msfs2024Telemetry</AssemblyName>
    <RootNamespace>SkylineVA.Msfs2024Telemetry</RootNamespace>
    <Version>0.1.18</Version>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>None</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="SimConnect.NET" Version="0.2.2" />
    <None Include="..\msfs-telemetry\data\airport-catalog.json" Link="data\airport-catalog.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <InternalsVisibleTo Include="SkylineVA.Msfs2024Telemetry.Tests" />
  </ItemGroup>
</Project>
